<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="automation-log-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="automation_log"/></not>
        </preConditions>
        <createTable tableName="automation_log">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(24)">
                <constraints nullable="false"/>
            </column>
            <column name="items_processed" type="int" defaultValue="0"/>
            <column name="items_succeeded" type="int" defaultValue="0"/>
            <column name="items_failed" type="int" defaultValue="0"/>
            <column name="error_message" type="text"/>
            <column name="started_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="timestamp"/>
            <column name="metadata" type="jsonb"/>
        </createTable>
        <createIndex indexName="idx_automation_log_job_type" tableName="automation_log">
            <column name="job_type"/>
        </createIndex>
        <createIndex indexName="idx_automation_log_started_at" tableName="automation_log">
            <column name="started_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-user-notification-preferences-table" author="Dylan_zote">
        <createTable tableName="user_notification_preferences">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValue="true"/>
            <column name="quiet_hours_start" type="TIME"/>
            <column name="quiet_hours_end" type="TIME"/>
            <column name="preferences" type="JSONB"/>
            <column name="locale" type="VARCHAR(10)" defaultValue="en"/>
            <column name="timezone" type="VARCHAR(255)"/>
            <!-- Auditable fields -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="user_notification_preferences" indexName="idx_preferences_user_channel">
            <column name="user_id"/>
            <column name="channel"/>
        </createIndex>

        <addUniqueConstraint tableName="user_notification_preferences"
                             constraintName="uk_preferences_user_channel"
                             columnNames="user_id,channel"/>
    </changeSet>

</databaseChangeLog>

